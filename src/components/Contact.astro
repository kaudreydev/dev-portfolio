---
import { type CollectionEntry, getCollection } from "astro:content";
import type { Contact } from "~/types";
import ExternalLink from "./utils/ExternalLink.astro";
import IconLink from "./utils/IconLink.astro";

const contact = await getCollection("contact");
const allContacts = contact.map(
  (entry: CollectionEntry<"contact">) => entry.data as Contact,
);
---

<section>
  <h2 id="contact">Contact</h2>
  <ul>
    {
      allContacts.map((contact: Contact) => (
        <li>
          <IconLink
            href={contact.href}
            type={contact.type}
            title={contact.title}
          />
        </li>
      ))
    }
  </ul>
</section>
