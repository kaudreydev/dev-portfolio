---
import Navigation from "@components/utils/Navigation";
import { type NavItem } from "~/types";

interface Props {
  nav: NavItem[];
}

const { nav } = Astro.props as Props;
---

<header
  id="header"
  class="w-full justify-center md:pb-10 flex items-center flex-col fixed top-0 left-1/2 -translate-x-1/2 bg-background z-40"
>
  <Navigation nav={nav} client:only="react" />
  <div
    class="absolute -bottom-10 left-0 w-full h-10 md:h-18 pointer-events-none bg-linear-to-b from-background via-background/80 to-background/20 z-10"
  >
  </div>
</header>
