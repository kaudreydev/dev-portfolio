---
import { Image } from "astro:assets";
import SkillExpert from "@images/signal.svg";
import SkillProficient from "@images/signal-high.svg";
import SkillGrowing from "@images/signal-medium.svg";
import SkillFamiliar from "@images/signal-low.svg";

interface Props {
  proficiencyLevel: number;
}

const { proficiencyLevel } = Astro.props;
---

<div class="flex bg-gray-700 rounded-2xl w-16 p-2 items-center">
  {
    proficiencyLevel === 0 && (
      <Image alt="Skill Proficiency Familiar" src={SkillFamiliar} />
    )
  }
  {
    proficiencyLevel === 1 && (
      <Image alt="Skill Proficiency Familiar" src={SkillGrowing} />
    )
  }
  {
    proficiencyLevel === 2 && (
      <Image alt="Skill Proficiency Growing" src={SkillProficient} />
    )
  }
  {
    proficiencyLevel === 3 && (
      <Image alt="Skill Proficiency Proficient" src={SkillExpert} />
    )
  }
</div>

<style>
  img {
    filter: brightness(0) saturate(100%) invert(87%) sepia(30%) saturate(5375%)
      hue-rotate(275deg) brightness(90%) contrast(90%);
  }
</style>
