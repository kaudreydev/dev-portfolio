---
import { getSVG } from "~/lib/utils";

export interface Props {
  fontSize?: string;
  href: string;
  type: string;
  title: string;
}

const { fontSize, href, type, title } = Astro.props;

const iconSize = 48;
const attributes = {
  "aria-hidden": true,
  focusable: "false",
  height: iconSize,
  width: iconSize,
  xmlns: "http://www.w3.org/2000/svg",
};
const { attributes: baseAttributes, innerHTML } = getSVG(type);

const svgAttributes = {
  ...baseAttributes,
  ...attributes,
};
---

<a
  class="external-link"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${title} (external link)`}
  title={`${title} (external link)`}
>
  <span class="sr-only">(external link)</span>
  <svg {...svgAttributes} set:html={innerHTML} />

  <style define:vars={{ fontSize, iconSize }}>
    a {
      align-items: center;
      color: var(--color-purple-light);
      display: inline-flex;
      font-size: var(--fontSize);
      gap: var(--space-3xs);
      width: fit-content;
    }

    svg {
      height: var(--iconSize);
      width: var(--iconSize);
    }

    .dark {
      fill: transparent;
    }

    .light {
      fill: var(--color-purple-light);
    }

    @media (prefers-color-scheme: light) {
      a {
        color: var(--color-purple-dark);
      }

      .dark {
        fill: var(--color-purple-dark);
      }

      .light {
        fill: transparent;
      }
    }
  </style>
</a>
