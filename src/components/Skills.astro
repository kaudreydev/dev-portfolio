---
import { type CollectionEntry, getCollection } from "astro:content";
import type { Skill } from "~/types";
import SkillCards from "./utils/SkillCards";

const skillsCollection = await getCollection("skills");
const allSkills = skillsCollection.map(
  (entry: CollectionEntry<"skills">) => entry.data as Skill,
);
---

<h2 id="skills" class="md:-mt-8 sr-only">Skills</h2>
<details id="skills-details" class="w-full">
  <summary class="text-4xl py-8">
    <span class="inline font-heading">Skills</span>
  </summary>
  <div id="skills-content">
    <SkillCards skills={allSkills} client:only="react" />
  </div>
</details>
