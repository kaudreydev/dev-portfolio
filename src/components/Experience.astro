---
import { type CollectionEntry, getCollection } from "astro:content";
import lodash from "lodash";
import type { Reference } from "~/types";

const { chain } = lodash;

const experienceCollection = await getCollection("experience");
const allJobs = chain(experienceCollection)
  .map((entry: CollectionEntry<"experience">) => entry.data as Reference)
  .sortBy("years")
  .reverse()
  .value();
---

<details id="experience-details" class="w-full">
  <summary id="experience" class="text-4xl py-8"
    ><h2 class="inline text-4xl">Experience</h2></summary
  >
  <ul class="list-none pl-4">
    {
      allJobs.map((job: Reference) => (
        <li class="py-2">
          <span>
            <b class="text-xl md:text-2xl">
              {job.title} - {job.company}
            </b>{" "}
            ({job.years})
          </span>
          <ul class="py-2 pl-4 md:pl-8">
            {job.details.map((detail: string) => (
              <li class="text-lg py-1">{detail}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</details>
