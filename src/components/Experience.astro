---
import { type CollectionEntry, getCollection } from "astro:content";
import lodash from "lodash";
import type { Reference } from "~/types";

const { chain } = lodash;

const experienceCollection = await getCollection("experience");
const allJobs = chain(experienceCollection)
  .map((entry: CollectionEntry<"experience">) => entry.data as Reference)
  .sortBy("years")
  .reverse()
  .value();
---

<section>
  <h2 id="experience">Experience</h2>
  <ul class="list-none">
    {
      allJobs.map((job: Reference) => (
        <li class="py-2">
          <span>
            <b>
              {job.title} - {job.company}
            </b>{" "}
            ({job.years})
          </span>
          <ul class="py-2">
            {job.details.map((detail: string) => (
              <li class="text-lg py-1">{detail}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</section>
