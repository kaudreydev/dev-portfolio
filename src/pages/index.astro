---
import About from "@components/About.astro";
import Contact from "@components/Contact.astro";
import Experience from "@components/Experience.astro";
import Header from "@components/Header.astro";
import Projects from "@components/Projects.astro";
import Skills from "@components/Skills.astro";
import { description, title } from "@content/site.json";
import Layout from "@layouts/Layout.astro";
import BackToTop from "@utils/BackToTop.astro";

const nav = [
  { path: `#about`, text: "about" },
  { path: `#skills`, text: "skills" },
  { path: `#experience`, text: "experience" },
  { path: `#projects`, text: "projects" },
  { path: `#contact`, text: "contact" },
];
---

<Layout title={title} description={description}>
  <Header nav={nav} />
  <main class="justify-items-center w-full py-30 md:px-8">
    <div class="sr-only" id="start"></div>
    <About />
    <Skills />
    <Experience />
    <Projects />
    <Contact />
  </main>
  <section aria-label="Utilities">
    <!-- You could also add a theme switch here or anything considered a utility -->
    <BackToTop />
  </section>
</Layout>
