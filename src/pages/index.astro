---
import About from "@components/About.astro";
import Contact from "@components/Contact.astro";
import Credit from "@components/Credit.astro";
import Experience from "@components/Experience.astro";
import Header from "@components/Header.astro";
import Projects from "@components/Projects.astro";
import Skills from "@components/Skills.astro";
import { description, title } from "@content/site.json";
import Layout from "@layouts/Layout.astro";
import BackToTop from "@utils/BackToTop.astro";

const nav = [
  { id: "about", path: `#about`, text: "about" },
  { id: "skills", path: `#skills`, text: "skills" },
  { id: "experience", path: `#experience`, text: "experience" },
  { id: "projects", path: `#projects`, text: "projects" },
  { id: "contact", path: `#contact`, text: "contact" },
];
---

<Layout title={title} description={description}>
  <div class="sr-only" id="start"></div>
  <Header nav={nav} />
  <main
    class="justify-items-center w-full mt-8 sm:mt-12 md:mt-8 pt-16 pb-10 md:py-30 md:px-50"
  >
    <About />
    <Skills />
    <Experience />
    <Projects />
    <Contact />
    <Credit />
  </main>
  <section aria-label="Utilities">
    <!-- You could also add a theme switch here or anything considered a utility -->
    <BackToTop />
  </section>
</Layout>

<script>
  import { userTheme } from "~/store";

  const savedTheme = userTheme.get();

  if (!savedTheme) {
    userTheme.set(
      window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light",
    );
  }
</script>

<script>
  (globalThis as any).__zod_globalConfig = { jitless: true };
</script>
