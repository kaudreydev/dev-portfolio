---
import Layout from "@layouts/Layout.astro";
import { description } from "@content/site.json";
---

<Layout title="Page not found - 404" description={description}>
  <header>
    <h1>Page not found - 404</h1>
    <p>
      Looks like something is wrong with the URL. Let's take you back to the <a
        href="/">Homepage</a
      >!
    </p>
  </header>
</Layout>

<style>
  header {
    margin: 0 auto;
    max-width: 666px;
  }
</style>
