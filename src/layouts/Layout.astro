---
import "@styles/custom.css";
import "@styles/global.css";
import "@styles/reset.css";
import "@styles/variables.css";
import PageMetadata from "~/components/utils/PageMetadata.astro";
import type { ImageMetadata } from "~/types";

const socialImageURL = new URL("/seo.png", Astro.url);

const metaData = {
  keywords: "html, css, javascript, astro, static site generator",
  image: {
    url: socialImageURL,
    type: "image/png",
    width: "1600",
    height: "882",
  } as ImageMetadata,
  siteName: "KAudreyDev",
};

interface Props {
  title: string;
  description: string;
  alternateLinks?: { href: string; hreflang: string }[];
}

const { title, description, alternateLinks } = Astro.props as Props;
---

<!doctype html>
<html lang="en">
  <head>
    <PageMetadata
      title={title}
      description={description}
      keywords={metaData.keywords}
      siteName={metaData.siteName}
      image={metaData.image}
      enableClientRouter
      ogType="website"
      favicons={[
        {
          rel: "icon",
          type: "image/svg+xml",
          href: "/favicon-astronaut.svg",
          sizes: "32x32",
        },
      ]}
      alternateLinks={alternateLinks}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
